@startuml use-case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Employee as E
actor Technician as T
actor "Team lead" as TL
actor Administrator as A
actor "IT manager" as M
actor "Scheduler\n(SLA monitor)" as S
actor "Email server" as Mail
actor "Push service\n(ntfy)" as Push
actor "Gemini API" as LLM

TL -|> T

rectangle TriageGraph {
  usecase "Register / log in" as UC1
  usecase "Report incident" as UC2
  usecase "Get category and\nduplicate suggestions" as UC3
  usecase "Join existing incident" as UC4
  usecase "Track my incidents" as UC5
  usecase "Provide requested info" as UC6
  usecase "Verify or reopen;\ngive feedback" as UC7
  usecase "Work assigned queue\n(acknowledge, notes, resolve)" as UC8
  usecase "Request info from reporter" as UC9
  usecase "Merge duplicate" as UC10
  usecase "View similar incidents and\nsuggested resolution" as UC11
  usecase "Reassign incident" as UC12
  usecase "Manage users and technicians" as UC13
  usecase "Configure services, categories,\nSLA policies, strategies" as UC14
  usecase "Monitor Command Centre" as UC15
  usecase "View reports / export CSV" as UC16
  usecase "View and verify audit trail" as UC17
  usecase "Declare major incident" as UC18
  usecase "Receive notifications" as UC19
  usecase "Search incidents" as UC20
  usecase "Prioritise and auto-assign" as UC21
  usecase "Detect SLA warning / breach" as UC22
  usecase "Escalate" as UC23
  usecase "Send test notification" as UC24
}

E --> UC1
E --> UC2
E --> UC5
E --> UC6
E --> UC7
E --> UC19
UC2 ..> UC3 : <<include>>
UC2 ..> UC21 : <<include>>
UC4 ..> UC2 : <<extend>>

T --> UC1
T --> UC8
T --> UC9
T --> UC10
T --> UC11
T --> UC19
T --> UC20

TL --> UC12

A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC17
A --> UC18
A --> UC24

M --> UC15
M --> UC16
M --> UC17

S --> UC22
UC22 ..> UC23 : <<include>>
UC23 ..> UC19 : <<include>>

UC19 --> Mail
UC19 --> Push
UC3 --> LLM
@enduml
