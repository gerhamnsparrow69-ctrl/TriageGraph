# Copy to .env and fill in. Never commit .env.

# HS256 signing key for login tokens: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Google AI Studio key for the Gemini features (Member 2). Leave empty to run without the LLM.
GEMINI_API_KEY=

# Push notifications to phones via ntfy.
NTFY_BASE_URL=https://ntfy.sh

# Database (matches docker-compose.yml defaults)
DB_URL=jdbc:postgresql://localhost:5432/triagegraph
DB_USER=triagegraph
DB_PASSWORD=triagegraph

# Mail (Mailpit from docker-compose.yml)
MAIL_HOST=localhost
MAIL_PORT=1025
